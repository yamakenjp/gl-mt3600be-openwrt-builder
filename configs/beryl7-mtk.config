CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_glinet_gl-mt3600be=y

# LuCI and travel-router relay support
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_relayd=y
CONFIG_PACKAGE_luci-proto-relay=y

# MediaTek public-feed acceleration helpers
CONFIG_PACKAGE_kmod-mt798x-2p5g-phy=y
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ipt-offload=y
CONFIG_PACKAGE_netfilter-flowtable=y
CONFIG_CRYPTO_OFFLOAD_INLINE_FLOWBLOCK=y
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_iptables-mod-extra=y
CONFIG_PACKAGE_iptables-mod-ipopt=y
CONFIG_PACKAGE_iptables-zz-legacy=y
CONFIG_PACKAGE_mtkhnat_util=y
CONFIG_PACKAGE_smp_util=y

# Useful Wi-Fi and USB diagnostics without SDK test/debug payloads
CONFIG_PACKAGE_hostapd-utils=y
CONFIG_PACKAGE_wpa-cli=y
CONFIG_PACKAGE_iw-full=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_usbutils=y

# Keep this as a deployable image, not a MediaTek HQA/debug image
# CONFIG_COLLECT_KERNEL_DEBUG is not set
# CONFIG_KERNEL_PROFILING is not set
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_DEBUG is not set
# CONFIG_DEVEL is not set
# CONFIG_PACKAGE_mt76-test is not set
# CONFIG_PACKAGE_perf is not set
# CONFIG_PACKAGE_atenl is not set
# CONFIG_PACKAGE_quick_track is not set
